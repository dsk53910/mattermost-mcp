                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": {
              "raw": "{{apiBaseUrl}}/users/me",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Verifies that the session token from login works as a Bearer token."
          },
          "response": []
        },
        {
          "name": "Get Me (Browser Session)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "MMAUTHTOKEN={{mmAuthToken}}; MMCSRF={{mmCsrf}}; MMUSERID={{mmUserId}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{mmCsrf}}"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "url": {
              "raw": "{{apiBaseUrl}}/users/me",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Verifies browser-style cookie auth with `MMAUTHTOKEN`, `MMCSRF`, and `MMUSERID`."
          },
          "response": []
        }
      ]
    },
